*{box-sizing:border-box}html{background-color:#112f41}body{background-color:#f6fbf9;margin:0;min-height:100%;font-family:raleway,helvetica neue,sans-serif;color:#112f41;font-size:16px}@media(max-width:767px){body{line-height:1.7em}}ul{margin-top:0}li{line-height:1.5em}p::selection{background-color:#eaedf0;color:#364049}p{display:block;font-weight:400;font-size:1em;margin-top:0;margin-bottom:.7rem;line-height:1.5em;text-align:start}h1,h2,h3,h4,h5{font-family:montserrat,helvetica neue,sans-serif;letter-spacing:.02em;margin:1.45rem 0 .45rem;line-height:1.25}h1{font-size:36px;font-weight:600}h2{font-size:30px;font-weight:600}h3{font-size:24px;font-weight:500}h4{font-size:20px;font-weight:500}blockquote{margin:0 5px;font-size:1em;line-height:1.5em;text-align:start;font-style:italic}blockquote:before{font-family:Georgia,serif;content:'\201C';position:absolute;top:.15em;left:-.18em;color:#dce0e5;font-size:7em;z-index:-1;font-style:italic}figure{margin:0}figure img{margin-bottom:6px!important}figure figcaption p{font-size:14px;text-align:center}a{color:#075d63;font-weight:600;text-underline-offset:.14em;text-decoration-thickness:1px}a:hover{color:#003f45;text-decoration-thickness:2px}a:focus-visible{outline:2px solid currentColor;outline-offset:3px}.site-header{position:fixed;inset:0 auto 0 0;width:16rem;overflow-y:auto;padding:2rem 1.6rem;background:#112f41;color:#fcfcfd}.site-header-inner,.site-identity,.site-nav{display:flex;flex-direction:column;align-items:flex-start}.site-header-inner{gap:1.25rem}.site-header a,footer a{color:inherit}.site-identity{gap:.85rem;text-decoration:none}.site-identity img{display:block;border-radius:50%}.site-name,.site-position{display:block}.site-name{font:600 1.8rem/1.2 montserrat,helvetica neue,sans-serif}.site-position{margin-top:.3rem;color:#d8e9ea;font-weight:400;line-height:1.4}.site-nav{gap:.15rem}.site-nav a{display:inline-flex;align-items:center;min-height:2rem;text-decoration:none}.site-identity:hover .site-name,.site-nav a:hover{text-decoration:underline}.site-contact{display:flex;flex-wrap:wrap;align-items:center;gap:.25rem 1rem;font-size:.95rem}.content-wrapper,footer{margin-left:16rem;padding:1.9rem clamp(2rem,4vw,4rem)}.content-wrapper{min-height:88vh}#content,.breadcrumb,.footer-wrapper{max-width:52rem;margin:0 auto}#content{overflow-wrap:break-word}#content>h1:first-child{margin-top:0}#content>p{max-width:68ch}#content h2+h3{margin-top:.55rem}#content h3{font-size:1.22rem;margin-bottom:.4rem}.breadcrumb{margin-bottom:.75rem}.publication-list{margin:0;padding-inline-start:2rem;color:#354e59}.publication-list>li{padding-inline-start:.12rem;margin-bottom:.55rem;line-height:1.42}.publication-list>li::marker{color:#4d6570;font-variant-numeric:tabular-nums}.publication-list>li>a:first-child{display:block;width:fit-content;max-width:100%}.paper-entry{display:grid;container-type:inline-size;grid-template-columns:minmax(0,max-content)max-content 1fr;grid-template-areas:"title links ." "citation citation citation" "abstract abstract abstract";align-items:baseline}.paper-details,.paper-title{grid-area:title;min-width:0}.paper-title{font-weight:700;color:#112f41}summary.paper-title{cursor:pointer;list-style:none;text-decoration:underline;text-underline-offset:.14em;text-decoration-thickness:1px}summary.paper-title::-webkit-details-marker{display:none}summary.paper-title:hover,summary.paper-title:focus-visible{color:#075d63;text-decoration-thickness:2px}summary.paper-title:focus-visible{outline:2px solid currentColor;outline-offset:3px}.paper-links{grid-area:links;display:inline-flex;gap:.28rem}.paper-links a{margin-block:.12rem;padding:.13rem .38rem;border:1px solid #a1bdba;border-radius:.25rem;background:#f1f7f5;font-size:.77rem;line-height:1.3;text-decoration:none}.paper-links a:first-child{margin-inline-start:.5rem}.paper-links a:hover{background:#dcece6;border-color:initial}.paper-citation{grid-area:citation}.paper-abstract{grid-area:abstract;min-width:0;width:100cqi;overflow-x:auto;margin:.45rem 0 .35rem;padding:.65rem .85rem;border-left:3px solid #93b7b0;background:#eef5f2;color:#112f41}.paper-abstract p:last-child{margin-bottom:0}.paper-abstract mjx-container[display=true]{overflow-x:auto;max-width:100%}@supports selector(details::details-content){.paper-details{display:contents}.paper-details::details-content{grid-area:abstract;min-width:0}}.teaching-section p{margin-bottom:.15rem}.teaching-section ul{padding-inline-start:1.5rem;margin-bottom:.6rem}footer{background:#112f41;color:#fcfcfd;padding-block:1rem;font-size:.9rem}footer p{margin-bottom:0}img.gopher{margin:0 auto 30px!important;max-width:200px}@media(max-width:1023px){.site-header{position:static;width:auto;padding:.9rem 2rem;overflow:visible}.site-header-inner{max-width:52rem;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr)auto;grid-template-areas:"identity contact" "navigation navigation";gap:.4rem 1rem;align-items:center}.site-identity{grid-area:identity;flex-direction:row;align-items:center}.site-identity img{width:3.5rem;height:3.5rem}.site-name{font-size:1.4rem}.site-position{margin-top:.1rem;font-size:.95rem}.site-nav{grid-area:navigation;flex-direction:row;flex-wrap:wrap;gap:0 1rem}.site-contact{grid-area:contact}.content-wrapper,footer{margin-left:0;padding-inline:2rem}.content-wrapper{padding-block:1.35rem;min-height:auto}}@media(max-width:767px){.site-header,.content-wrapper,footer{padding-inline:clamp(1.125rem,5vw,1.25rem)}.publication-list{padding-inline-start:1.65rem}}@media(max-width:36rem){.paper-links a{display:inline-flex;align-items:center;min-height:2rem}.site-header-inner{grid-template-columns:minmax(0,1fr);grid-template-areas:"identity" "navigation" "contact";gap:.25rem}.site-nav{column-gap:.45rem;font-size:.9375rem}#content h1{font-size:1.85rem}#content h2{font-size:1.5rem}}.small{font-size:13px}.active{font-weight:500}#content .icon,header .icon{margin-right:5px;display:inline-block}#content .icon svg,header .icon svg{width:auto}header .icon{fill:#fff;margin-right:10px}#content .icon{fill:#112f41}#content:not(.portfolio) img{width:110%;display:block;margin:0 -5%}.published-date,.reading-time{display:inline-block;margin-bottom:20px}.reading-time{margin-right:20px}.img-caption{margin-bottom:5px!important}.portfolio img{max-width:100%;margin-bottom:30px;box-shadow:0 0 5px #112F41}.portfolio .rounded-img{width:150px;height:150px;border-radius:50%}.portfolio .testimonial-list{margin:0 auto;display:flex}.portfolio .testimonial-list .testimonial-container{display:inline-block;text-align:center}.portfolio .testimonial-list .testimonial-container .testimonial-name,.portfolio .testimonial-list .testimonial-container .testimonial-role{text-align:center;font-weight:600;font-size:18px;margin-top:-20px}.portfolio .testimonial-list .testimonial-container .testimonial-role{font-weight:400}.portfolio .testimonial-list .testimonial-container .testimonial-text{position:relative;z-index:0}.portfolio .portfolio-tags{margin-top:6px}.portfolio .portfolio-tags span{font-weight:600}.portfolio .portfolio-tags a{overflow-wrap:break-word}.portfolio .tags{margin-bottom:10px}#content .portfolio-list h2{margin:0}#content .portfolio-list a,#content .portfolio-list a:hover,#content .portfolio-list a:link,#content .portfolio-list a:active,#content .portfolio-list a:visited,#content .portfolio-list a:focus{border-bottom:none;color:inherit}#content .portfolio-list img{max-width:100%;border-radius:2px;display:block;box-shadow:0 0 5px #112F41;margin:inherit}#content .portfolio-list .portfolio-container{position:relative;max-width:52rem;margin-bottom:30px}#content .portfolio-list .portfolio-container .portfolio-details{opacity:0;display:none;width:100%;padding:2em 1em;color:#f6eb0f;-webkit-transition:opacity .4s ease;-moz-transition:opacity .4s ease;-ms-transition:opacity .4s ease;-o-transition:opacity .4s ease;transition:opacity .4s ease}#content .portfolio-list .portfolio-container .portfolio-details p,#content .portfolio-list .portfolio-container .portfolio-details h2{text-align:center;margin-bottom:0;position:relative}#content .portfolio-list .portfolio-container .img-overlay{position:absolute;top:0;bottom:0;left:0;right:0;height:100%;width:100%;opacity:0;-webkit-transition:.4s ease;-moz-transition:.4s ease;-ms-transition:.4s ease;-o-transition:.4s ease;transition:.4s ease;background-color:#112f41}#content .portfolio-list .portfolio-container:hover .img-overlay{opacity:.7}#content .portfolio-list .portfolio-container:hover .portfolio-details{opacity:1;display:block;position:absolute;top:50%;left:50%;-webkit-transform:translate(-50%,-50%);-ms-transform:translate(-50%,-50%);transform:translate(-50%,-50%)}#content .portfolio-list img::hover{linear-gradient:#112F41,#112F41}@media(max-width:767px){#content .portfolio-list .portfolio-container img{margin-bottom:0}#content .portfolio-list .portfolio-container .img-overlay{display:none}#content .portfolio-list .portfolio-container .portfolio-details{display:block;opacity:1;width:100%;padding:0;color:#364049}#content .portfolio-list .portfolio-container .portfolio-details h2{font-size:24px;line-height:1.5em}#content .portfolio-list .portfolio-container .portfolio-details h2 span{background-image:linear-gradient(180deg,transparent 60%,#F6EB0F 0);padding:0 .2em}#content .portfolio-list .portfolio-container .portfolio-details p,#content .portfolio-list .portfolio-container .portfolio-details h2{text-align:center;margin-bottom:0;position:relative}#content .portfolio-list .portfolio-container:hover .portfolio-details{-webkit-transform:none;-ms-transform:none;transform:none;position:relative;left:0}}.designs,.techs{display:inline-block}.designs{margin-right:20px}.read-more{margin-top:-10px;text-align:right;display:block}.chroma{padding:10px}